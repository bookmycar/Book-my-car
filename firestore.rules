rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'bookmycar.cg@gmail.com'; }
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid)); }

    match /owners/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /publicCars/{carId} {
      allow read: if true;
      allow create: if isAdmin() || (isOwner() && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isOwner() && resource.data.ownerUid == request.auth.uid);
    }

    match /cars/{carId} {
      allow read: if isAdmin() || isOwner();
      allow create: if isAdmin() || (isOwner() && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isOwner() && resource.data.ownerUid == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (isOwner() && resource.data.ownerUid == request.auth.uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}